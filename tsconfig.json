{
  "compileOnSave": false,
  "compilerOptions": {
    "module": "commonjs",
    "skipLibCheck": true,
    "target": "es6",
    "noImplicitAny": false,
    "strictNullChecks": false,
    "experimentalDecorators": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "esModuleInterop": true,
    "noUnusedLocals": true
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "coverage",
    "node_modules",
    "dist"
  ]
}
